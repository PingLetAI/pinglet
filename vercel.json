{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm --prefix website install",
  "buildCommand": "npm --prefix website run build",
  "outputDirectory": "website/dist",
  "rewrites": [
    {
      "source": "/get.html",
      "destination": "/get.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/get.html",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(iPhone|iPad|iPod).*"
        }
      ],
      "destination": "https://apps.apple.com/us/app/pinglet-ai/id6806096564",
      "permanent": false
    },
    {
      "source": "/get.html",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*Android.*"
        }
      ],
      "destination": "/download?preview",
      "permanent": false
    }
  ]
}
