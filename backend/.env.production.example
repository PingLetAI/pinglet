# =============================================================================
# PingLet Backend — Production Environment
# =============================================================================
# Copy this to .env.production and fill in all values before deploying.
#   cp backend/.env.production.example backend/.env.production
# =============================================================================

# --- Database ----------------------------------------------------------------
POSTGRES_DB=pinglet_prod
POSTGRES_USER=pinglet
POSTGRES_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD
DATABASE_URL=postgresql://pinglet:CHANGE_ME_TO_A_STRONG_PASSWORD@postgres:5432/pinglet_prod

# --- Redis -------------------------------------------------------------------
REDIS_URL=redis://redis:6379

# --- Auth --------------------------------------------------------------------
# Generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL
JWT_EXPIRATION=900
JWT_REFRESH_EXPIRATION=1209600

# Generate with: openssl rand -hex 32
ADMIN_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL

# Generate with: openssl rand -hex 32
OTP_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL

# --- App ---------------------------------------------------------------------
APP_PORT=3000

# --- OpenAI ------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_EXTRACTION_MODEL=gpt-5.4-mini
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-transcribe
INGESTION_CONCURRENCY=2

# --- Email (Resend) ----------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM=PingLet <hello@pinglet.ai>

# --- Google Play Billing -----------------------------------------------------
GOOGLE_PLAY_PACKAGE_NAME=ai.pinglet.app
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
