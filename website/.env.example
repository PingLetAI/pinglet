VITE_PUBLIC_SITE_URL=https://pinglet.ai
VITE_APP_STORE_URL=

# Public release switches. Keep false during TestFlight / pre-launch.
# After the iOS public launch, set VITE_APP_STORE_URL to the live listing
# (https://apps.apple.com/app/id6806096564) and VITE_IOS_RELEASED=true.
# Vite embeds these values at build time: rebuild and deploy the website.
VITE_IOS_RELEASED=false
VITE_ANDROID_RELEASED=false
